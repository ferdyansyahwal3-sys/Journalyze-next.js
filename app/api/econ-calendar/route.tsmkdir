// app/api/econ-calendar/route.ts
// Port dari api/econ-calendar.js (Vercel serverless) → Next.js App Router Route Handler
// Fungsi: fetch kalender ekonomi dari ForexFactory / investing.com, return JSON

import { NextRequest, NextResponse } from 'next/server';

export interface EconEvent {
  id: string;
  date: string;       // ISO date string
  time: string;       // e.g. "08:30", "All Day", "Tentative"
  currency: string;   // e.g. "USD", "EUR", "GBP"
  impact: 'low' | 'medium' | 'high' | 'holiday';
  event: string;      // nama event
  actual: string;     // "" jika belum release
  forecast: string;
  previous: string;
  detail?: string;
}

// Parse XML kalender ForexFactory
function parseFFCalendarXML(xml: string): EconEvent[] {
  const events: EconEvent[] = [];
  const weekdayRegex = /<weekday>([\s\S]*?)<\/weekday>/g;
  let wMatch;
  let currentDate = '';

  while ((wMatch = weekdayRegex.exec(xml)) !== null) {
    const wBlock = wMatch[1];

    // Extract date dari <date>
    const dateMatch = wBlock.match(/<date>([\s\S]*?)<\/date>/);
    if (dateMatch) {
      const rawDate = dateMatch[1].trim();
      // FF format: "Jan 01, 2024" → parse
      try {
        currentDate = new Date(rawDate).toISOString().split('T')[0];
      } catch {
        currentDate = rawDate;
      }
    }

    // Extract events
    const eventRegex = /<event>([\s\S]*?)<\/event>/g;
    let eMatch;

    while ((eMatch = eventRegex.exec(wBlock)) !== null) {
      const eBlock = eMatch[1];

      const get = (tag: string): string => {
        const m = eBlock.match(new RegExp(`<${tag}>(<!\\[CDATA\\[)?([\\s\\S]*?)(\\]\\]>)?<\\/${tag}>`));
        return m ? m[2].trim() : '';
      };

      const impactRaw = get('impact').toLowerCase();
      let impact: EconEvent['impact'] = 'low';
      if (impactRaw.includes('high') || impactRaw === '3') impact = 'high';
      else if (impactRaw.includes('medium') || impactRaw === '2') impact = 'medium';
      else if (impactRaw.includes('holiday')) impact = 'holiday';

      const id = get('id') || `${currentDate}-${Math.random().toString(36).slice(2, 7)}`;

      events.push({
        id,
        date: currentDate,
        time: get('time') || 'All Day',
        currency: get('currency').toUpperCase(),
        impact,
        event: get('title') || get('name'),
        actual: get('actual'),
        forecast: get('forecast'),
        previous: get('previous'),
        detail: get('description'),
      });
    }
  }

  return events;
}

// Fallback: generate mock data kalender ekonomi minggu ini
// (dipakai jika semua upstream gagal — supaya UI tidak kosong)
function generateMockCalendar(): EconEvent[] {
  const now = new Date();
  const startOfWeek = new Date(now);
  startOfWeek.setDate(now.getDate() - now.getDay() + 1); // Senin

  const mocks: EconEvent[] = [
    { id: 'm1', date: '', time: '08:30', currency: 'USD', impact: 'high', event: 'Non-Farm Payrolls', actual: '', forecast: '180K', previous: '175K' },
    { id: 'm2', date: '', time: '14:00', currency: 'USD', impact: 'high', event: 'FOMC Rate Decision', actual: '', forecast: '5.25%', previous: '5.25%' },
    { id: 'm3', date: '', time: '09:00', currency: 'EUR', impact: 'medium', event: 'CPI Flash Estimate y/y', actual: '', forecast: '2.4%', previous: '2.6%' },
    { id: 'm4', date: '', time: '07:00', currency: 'GBP', impact: 'medium', event: 'BOE Interest Rate Decision', actual: '', forecast: '5.00%', previous: '5.25%' },
    { id: 'm5', date: '', time: '01:30', currency: 'AUD', impact: 'low', event: 'RBA Meeting Minutes', actual: '', forecast: '', previous: '' },
    { id: 'm6', date: '', time: '08:30', currency: 'USD', impact: 'medium', event: 'Initial Jobless Claims', actual: '', forecast: '220K', previous: '215K' },
    { id: 'm7', date: '', time: '10:00', currency: 'EUR', impact: 'high', event: 'ECB Rate Decision', actual: '', forecast: '3.65%', previous: '3.65%' },
    { id: 'm8', date: '', time: '14:30', currency: 'USD', impact: 'medium', event: 'Crude Oil Inventories', actual: '', forecast: '-1.2M', previous: '2.3M' },
    { id: 'm9', date: '', time: '12:30', currency: 'CAD', impact: 'medium', event: 'BOC Rate Statement', actual: '', forecast: '', previous: '' },
    { id: 'm10', date: '', time: 'All Day', currency: 'JPY', impact: 'holiday', event: 'Bank Holiday — Japan', actual: '', forecast: '', previous: '' },
  ];

  // Assign dates across the week
  return mocks.map((m, i) => ({
    ...m,
    date: new Date(startOfWeek.getTime() + Math.floor(i / 2) * 86400000)
      .toISOString()
      .split('T')[0],
  }));
}

export async function GET(request: NextRequest) {
  const { searchParams } = new URL(request.url);
  const weekParam = searchParams.get('week'); // 'this' | 'next' | default: 'this'

  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Cache-Control': 'public, s-maxage=3600, stale-while-revalidate=7200', // cache 1 jam
  };

  const ffUrl =
    weekParam === 'next'
      ? 'https://www.forexfactory.com/ff_calendar_nextweek.xml'
      : 'https://www.forexfactory.com/ff_calendar_thisweek.xml';

  try {
    const response = await fetch(ffUrl, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; Journalyze/1.0; Calendar Fetcher)',
        'Accept': 'application/xml, text/xml, */*',
      },
      signal: AbortSignal.timeout(10000),
    });

    if (!response.ok) {
      throw new Error(`ForexFactory returned ${response.status}`);
    }

    const xml = await response.text();
    const events = parseFFCalendarXML(xml);

    if (events.length === 0) {
      throw new Error('Parsed 0 events — XML mungkin berubah format');
    }

    return NextResponse.json({ events, source: 'forexfactory', week: weekParam || 'this' }, { headers: corsHeaders });

  } catch (err) {
    // Fallback ke mock data supaya UI tetap tampil
    const events = generateMockCalendar();
    const message = err instanceof Error ? err.message : 'Unknown error';
    
    return NextResponse.json(
      {
        events,
        source: 'mock',
        week: weekParam || 'this',
        warning: `Upstream gagal (${message}) — menampilkan data simulasi`,
      },
      { headers: corsHeaders }
    );
  }
}

export async function OPTIONS() {
  return new NextResponse(null, {
    status: 204,
    headers: {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type',
    },
  });
}